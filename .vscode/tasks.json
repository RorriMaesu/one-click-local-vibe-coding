{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Local Llama Server",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -Command \"if (Test-Path 'D:\\llama-cpp\\run-server.bat') { & 'D:\\llama-cpp\\run-server.bat' } else { & 'C:\\llama-cpp\\run-server.bat' }\"",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
